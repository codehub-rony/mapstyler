# Use official Node LTS image (22 LTS works well with Vuetify 3 + Vite)
FROM node:22

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json yarn.lock ./

# Install dependencies
RUN yarn install

# Copy rest of your project
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Start dev server
CMD ["yarn", "dev", "--host", "0.0.0.0"]